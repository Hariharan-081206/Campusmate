# Copy to server/.env and fill in. server/.env is gitignored — never commit it.

# Port the API listens on (binds 0.0.0.0 so the Android emulator can reach it).
PORT=5000

# MongoDB connection string. A local MongoDB works fine:
#   mongodb://127.0.0.1:27017/campusmate
# or use an Atlas SRV URI.
MONGO_URI=mongodb://127.0.0.1:27017/campusmate

# Secret used to sign login tokens (30-day JWTs). Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Google AI Studio key (https://aistudio.google.com/apikey) — powers note summaries.
GEMINI_API_KEY=

# Optional ------------------------------------------------------------------
# Comma-separated models, tried in order when one is overloaded or unavailable.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite

# Set to 1 to return the raw OCR text instead of an error when Gemini fails
# (handy for a live demo). Default: errors reach the app.
# GEMINI_FALLBACK=1
