# Copy to .env.local (gitignored) if the default API address doesn't suit you.
#
# Defaults when unset:
#   Android emulator -> http://10.0.2.2:5000   (the host machine)
#   iOS / web        -> http://localhost:5000
#
# Physical Android phone over USB: keep localhost and run `npm run phone`
# (adb reverse for Metro on 8081 and the API on 5000).
# Physical phone over Wi-Fi: use your computer's LAN IP instead.
EXPO_PUBLIC_API_URL=http://localhost:5000
